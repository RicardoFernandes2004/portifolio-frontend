# URL pública usada pelo cliente (browser) e pelos Route Handlers do Next
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL interna usada por Route Handlers / Server Components (pode ser igual à pública)
API_URL=http://localhost:3001

# URL pública do site (produção). Sem ela, canonical, hreflang, sitemap e as
# imagens de OG apontam para localhost e nenhum crawler resolve.
NEXT_PUBLIC_SITE_URL=https://seudominio.com
